# Laravel API (include /api prefix)
# Local dev: use Vite proxy paths (see vite.config.ts server.proxy)
VITE_LARAVEL_API_URL=/api

# Node.js service (include /api prefix)
# Ensure the Node service CORS_ORIGINS includes your Vite dev origin (default http://localhost:5173)
VITE_NODE_API_URL=/node-api

# --- Production (Vercel + Render) ---
# Live app: https://task-management-react-exam-1gnmeomqi.vercel.app
# VITE_LARAVEL_API_URL=https://task-management-laravel-api-u2v9.onrender.com/api
# VITE_NODE_API_URL=https://task-management-node-services-g5ie.onrender.com/api

# App title shown in browser tab / header
VITE_APP_NAME=Task Management
